{
  "dependencies": {
    "js-yaml": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "// Development": "Development scripts",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "// Safety Scripts": "Safeguards against bad commits",
    "precommit": "npm run typecheck && npm run build",
    "verify": "npm run typecheck && npm run build",
    "safe-commit": "./scripts/safe-commit.sh",
    "prepush": "npm run verify",
    "// Quick Checks": "Quick checks",
    "check": "npm run typecheck",
    "check:all": "npm run verify",
    "// Git Helpers": "Git helper commands",
    "commit": "npm run precommit && git add -A && git commit",
    "push:safe": "npm run prepush && git push",
    "// CI/CD Simulation": "Local CI/CD simulation",
    "ci:local": "npm ci && npm run verify",
    "ci:validate": "npm run ci:local",
    "// Emergency": "Emergency",
    "format": "prettier --write .",
    "clean:hooks": "rm -f .git/hooks/pre-* && npm run setup:hooks",
    "setup:hooks": "husky install || cp scripts/hooks/* .git/hooks/"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run precommit",
      "pre-push": "npm run prepush",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "// Usage examples": [
    "npm run safe-commit 'feat: add new feature'",
    "npm run verify",
    "npm run push:safe",
    "npm run ci:local"
  ],
  "name": "frontendTrading",
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend Trading Application - React 19 + TypeScript + Vite",
  "license": "ISC",
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
