{
  "dependencies": {
    "js-yaml": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "// Development": "Development scripts",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "// Testing": "Test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "// Safety Scripts": "Safeguards against bad commits",
    "precommit": "npm run typecheck && npm test && npm run build",
    "verify": "npm run typecheck && npm test && npm run build",
    "safe-commit": "./scripts/safe-commit.sh",
    "prepush": "npm run verify",
    "// Quick Checks": "Quick checks",
    "check": "npm run typecheck",
    "check:all": "npm run verify",
    "// Git Helpers": "Git helper commands",
    "commit": "npm run precommit && git add -A && git commit",
    "push:safe": "npm run prepush && git push",
    "// CI/CD Simulation": "Local CI/CD simulation",
    "ci:local": "npm ci && npm run verify",
    "ci:validate": "npm run ci:local",
    "// Linting & Formatting": "Code quality checks",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "// Emergency": "Emergency",
    "format:all": "prettier --write .",
    "clean:hooks": "rm -f .git/hooks/pre-* && npm run setup:hooks",
    "setup:hooks": "husky install || cp scripts/hooks/* .git/hooks/"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run precommit",
      "pre-push": "npm run prepush",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "// Usage examples": [
    "npm run safe-commit 'feat: add new feature'",
    "npm run verify",
    "npm run push:safe",
    "npm run ci:local"
  ],
  "name": "frontendTrading",
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend Trading Application - React 19 + TypeScript + Vite",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/ui": "^4.0.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "msw": "^2.11.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}